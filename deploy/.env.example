# Copy this file to .env and fill in real values. .env is gitignored.
# All ASP.NET values use the "double underscore" env-var binding syntax,
# which maps to nested config keys (e.g. Jwt__Signing -> Jwt:Signing).

# --- Docker image (set by CI on each deploy; pinned to commit SHA) ---
API_IMAGE=YOUR_ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/psr-service-api:latest

# --- Database (RDS MySQL) ---
ConnectionStrings__Default=Server=YOUR_RDS_ENDPOINT;Port=3306;Database=psr_service;User=psr_app;Password=CHANGE_ME;TreatTinyAsBoolean=true;AllowUserVariables=true;SslMode=Required

# --- JWT signing key (generate with: openssl rand -base64 48) ---
Jwt__Signing=CHANGE_ME_at_least_32_characters_long_random_string
Jwt__Issuer=psr-service
Jwt__Audience=psr-service-wpf
Jwt__ExpiryHours=24
# Every session ends at this local hour, whatever lifetime it has left, so it dies overnight
# instead of at whatever time the user signed in. 3 = 03:00 IST; offset 5.5 = IST (no DST).
Jwt__DailyCutoffLocalHour=3
Jwt__LocalUtcOffsetHours=5.5

# --- TLS certificate password (from scripts/generate-cert.sh output) ---
Kestrel__Endpoints__Https__Certificate__Password=CHANGE_ME

# --- Admin seed password (only used on first run when no users exist) ---
SEED_ADMIN_PASSWORD=CHANGE_ME_on_first_deploy

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production
