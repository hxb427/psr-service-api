<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PSR.Service.Api</RootNamespace>
    <AssemblyName>PSR.Service.Api</AssemblyName>
    <UserSecretsId>psr-service-api-dev</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The bulk workflow helpers (ServicesEndpoints.Bulk.cs / .Workflow.cs) are internal rather than
         public: they are implementation detail of the endpoints, but their per-job guards and the
         idempotency that makes every bulk action safe to replay are worth testing directly. -->
    <InternalsVisibleTo Include="PSR.Service.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Async" />
  </ItemGroup>

</Project>
